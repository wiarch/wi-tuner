{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "wi-tuner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm run build:workspaces && pnpm run legacy:build",
    "build:workspaces": "turbo run build --filter=./apps/** --filter=./packages/**",
    "legacy:build": "vite build",
    "dev": "vite",
    "dev:app": "pnpm --filter @wi-tuner/app dev",
    "dev:landing": "pnpm --filter @wi-tuner/landing dev",
    "test": "pnpm run test:workspaces && node --test tests/js/*.test.js && node scripts/check-external-hosts.mjs",
    "test:workspaces": "turbo run test --filter=./apps/** --filter=./packages/**",
    "test:e2e": "playwright test",
    "lint": "turbo run lint --filter=./apps/** --filter=./packages/**",
    "typecheck": "turbo run typecheck --filter=./apps/** --filter=./packages/**",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs,json,md}\" \"packages/**/*.{ts,tsx,js,mjs,json,md}\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/forms": "^0.5.2",
    "autoprefixer": "^10.4.2",
    "concurrently": "^9.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "jquery": "^4.0.0",
    "laravel-vite-plugin": "^3.1.0",
    "postcss": "^8.4.31",
    "prettier": "^3.9.10",
    "select2": "^4.0.13",
    "simple-datatables": "^10.2.0",
    "tailwindcss": "^3.1.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
