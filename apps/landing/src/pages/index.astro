---
import Home from "../components/Home.astro";
import Base from "../layouts/Base.astro";
import { landing, softwareApplicationLd } from "../content";

const page = landing.es;
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "https://app.wi-tuner.app/";
const pageUrl = new URL("/", Astro.site ?? "https://wi-tuner.app").href;
---

<Base
    language="es"
    title={page.htmlTitle}
    description={page.description}
    path="/"
    jsonLd={softwareApplicationLd(page, pageUrl)}
>
    <Home page={page} appUrl={appUrl} />
</Base>
